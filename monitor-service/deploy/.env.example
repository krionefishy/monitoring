COMPOSE_PROJECT_NAME=monitoring_application
MONITOR_INSTANCE_ID=application-production
MONITOR_SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_READ_PASSWORD=
MONITOR_CONFIG_FILE=./application.direct.json
MONITOR_PORT=8088
# Required: nginx TCP peer as seen by the API container (host bridge gateway for host nginx).
# On first install, bootstrap with 127.0.0.1,::1, inspect the created network, then set the gateway and recreate api.
# Find bridge gateways: docker network inspect <project>_web --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
# Use exact IPs or a dedicated proxy CIDR; never use * or a public client network.
MONITOR_TRUSTED_PROXIES=
MONITOR_PUBLIC_ORIGIN=https://monitoring.example.com
MONITOR_COOKIE_SECURE=true
MONITOR_PUBLISH_SECONDS=300
MONITOR_RETENTION_DAYS=30
NGINX_LOG_DIRECTORY=/var/log/nginx
NGINX_LOG_GID=4
